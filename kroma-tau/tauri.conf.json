{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kroma",
  "version": "0.2.0",
  "identifier": "com.kroma.studio",
  "build": {
    "beforeDevCommand": "npm run dev --prefix kroma-web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix kroma-web",
    "frontendDist": "../kroma-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kroma",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "maximized": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.4"
    }
  }
}